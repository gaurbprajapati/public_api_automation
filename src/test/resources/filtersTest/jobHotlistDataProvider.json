{
    "Created By": [
        {
            "dbField": "userId",
            "filterType": "contains_at_least_one",
            "filterValue": "{{owner}}",
            "fieldType": "text",
            "desciption": "Owner is the user who created the hotlist",
            "expectedResult": "All hotlists created by the owner"
        },
        {
            "dbField": "userId",
            "filterType": "contains_at_least_one",
            "filterValue": "{{admin}}",
            "fieldType": "text",
            "desciption": "Admin is the user who created the hotlist",
            "expectedResult": "All hotlists created by the admin"
        },
        {
            "dbField": "userId",
            "filterType": "contains_at_least_one",
            "filterValue": "{{teamMember}}",
            "fieldType": "text",
            "desciption": "Team Member is the user who created the hotlist",
            "expectedResult": "All hotlists created by the team member"
        },
        {
            "dbField": "userId",
            "filterType": "contains_at_least_one",
            "filterValue": "{{restrictedTeamMember}}",
            "fieldType": "text",
            "desciption": "Restricted Team Member is the user who created the hotlist",
            "expectedResult": "All hotlists created by the restricted team member"
        },
        {
            "dbField": "userId",
            "filterType": "contains_at_least_one",
            "filterValue": "{{owner}},{{admin}}",
            "fieldType": "text",
            "desciption": "Owner or admin created the hotlist",
            "expectedResult": "All hotlists created by the owner or admin"
        },
        {
            "dbField": "userId",
            "filterType": "contains_at_least_one",
            "filterValue": "{{owner}},{{admin}},{{teamMember}}",
            "fieldType": "text",
            "desciption": "Owner, admin or team member created the hotlist",
            "expectedResult": "All hotlists created by the owner, admin or team member"
        },
        {
            "dbField": "userId",
            "filterType": "contains_at_least_one",
            "filterValue": "{{owner}},{{admin}},{{teamMember}},{{restrictedTeamMember}}",
            "fieldType": "text",
            "desciption": "Owner, admin, team member or restricted team member created the hotlist",
            "expectedResult": "All hotlists created by the owner, admin, team member or restricted team member"
        }
    ],

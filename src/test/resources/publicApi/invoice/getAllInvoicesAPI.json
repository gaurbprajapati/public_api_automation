{
	"$schema": "http://json-schema.org/draft-04/schema#",
	"title": "Get all invoices API response",
	"type": "object",
	"properties": {
		"current_page": {
			"type": "integer"
		},
		"data": {
			"type": "array",
			"items": {
				"type": "object",
				"properties": {
					"id": {
						"type": "integer"
					},
					"company_slug": {
						"type": "string"
					},
					"status_id": {
						"type": "integer"
					},
					"created_on": {
						"type": "string"
					},
					"updated_on": {
						"type": "string"
					}
				}
			}
		},
		"first_page_url": {
			"type": "string"
		},
		"from": {
			"type": "integer"
		},
		"next_page_url": {},
		"path": {
			"type": "string"
		},
		"per_page": {},
		"prev_page_url": {},
		"to": {
			"type": "integer"
		}
	},
	"required": [
		"current_page",
		"data",
		"first_page_url",
		"from",
		"next_page_url",
		"path",
		"per_page",
		"prev_page_url",
		"to"
	],
	"additionalProperties": true
}
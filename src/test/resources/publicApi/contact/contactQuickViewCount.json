{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["meta", "data"],
  "properties": {
    "meta": {
      "type": "object",
      "required": ["message", "requestUuid", "responseType", "timestamp", "status"],
      "properties": {
        "message": {
          "type": "string",
          "enum": ["Contact quick view data fetched successfully"]
        },
        "requestUuid": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "responseType": {
          "type": "object",
          "required": ["context", "code"],
          "properties": {
            "context": {
              "type": "string",
              "enum": ["Request is successful"]
            },
            "code": {
              "type": "integer",
              "enum": [103]
            }
          }
        },
        "timestamp": {
          "type": "string",
          "pattern": "^\\d{2}-\\d{2}-\\d{4} \\d{2}:\\d{2}:\\d{2}$"
        },
        "status": {
          "type": "integer",
          "enum": [200]
        }
      }
    },
    "data": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "allContacts",
          "myContacts",
          "notInAnyHotlist",
          "offLimitContacts"
        ],
        "properties": {
          "allContacts": {
            "type": "integer",
            "minimum": 0,
            "description": "Total number of contacts in the account"
          },
          "myContacts": {
            "type": "integer",
            "minimum": 0,
            "description": "Number of contacts owned by the current user"
          },
          "notInAnyHotlist": {
            "type": "integer",
            "minimum": 0,
            "description": "Number of contacts not in any hotlist"
          },
          "offLimitContacts": {
            "type": "integer",
            "minimum": 0,
            "description": "Number of contacts marked as off-limit"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}


{
    "$schema": "http://json-schema.org/draft-04/schema#",
    "type": "object",
    "properties": {
        "job_slug": {
            "type": "string"
        },
        "candidate_slug": {
            "type": "string"
        },
        "status": {
            "type": "object",
            "properties": {
                "status_id": {
                    "type": "integer"
                },
                "label": {
                    "type": "string"
                }
            },
            "required": [
                "status_id",
                "label"
            ]
        },
        "remark": {
            "type": [
                "null",
                "string"
            ]
        },
        "stage_date": {
            "type": "string"
        },
        "visibility": {
            "type": "integer"
        },
        "shared_list_url": {
            "type": [
                "null",
                "string"
            ]
        },
        "updated_on": {
            "type": "string"
        },
        "updated_by": {
            "type": "integer"
        }
    },
    "required": [
        "job_slug",
        "candidate_slug",
        "status",
        "remark",
        "stage_date",
        "visibility",
        "shared_list_url",
        "updated_on",
        "updated_by"
    ]
}
{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["meta", "data"],
  "properties": {
    "meta": {
      "type": "object",
      "required": ["message", "requestUuid", "responseType", "timestamp", "status"],
      "properties": {
        "message": {
          "type": "string",
          "enum": ["Entities retrieved successfully"]
        },
        "requestUuid": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "responseType": {
          "type": "object",
          "required": ["context", "code"],
          "properties": {
            "context": {
              "type": "string",
              "enum": ["Request is successful"]
            },
            "code": {
              "type": "integer",
              "enum": [103]
            }
          },
          "additionalProperties": false
        },
        "timestamp": {
          "type": "string",
          "pattern": "^\\d{2}-\\d{2}-\\d{4} \\d{2}:\\d{2}:\\d{2}$"
        },
        "status": {
          "type": "integer",
          "enum": [200]
        }
      },
      "additionalProperties": false
    },
    "data": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "entityType",
          "json",
          "userId",
          "accountId",
          "createdBy",
          "createdOn",
          "updatedBy",
          "updatedOn",
          "shareWithTeammates",
          "postSearchRevamp",
          "collaboratorId",
          "collaboratorType",
          "appliedFilterSearchSavedWith",
          "isPinned"
        ],
        "properties": {
          "id": {
            "type": "integer",
            "minimum": 1
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "entityType": {
            "type": "string",
            "enum": ["jobs"]
          },
          "json": {
            "type": "string"
          },
          "userId": {
            "type": "integer",
            "minimum": 1
          },
          "accountId": {
            "type": "integer",
            "minimum": 1
          },
          "createdBy": {
            "type": "integer",
            "minimum": 1
          },
          "createdOn": {
            "type": "integer",
            "minimum": 1
          },
          "updatedBy": {
            "type": "integer",
            "minimum": 1
          },
          "updatedOn": {
            "type": "integer",
            "minimum": 1
          },
          "shareWithTeammates": {
            "type": "integer",
            "minimum": 0
          },
          "postSearchRevamp": {
            "type": "integer",
            "enum": [0, 1]
          },
          "collaboratorId": {
            "type": ["array", "null"],
            "items": {
              "type": "integer"
            }
          },
          "collaboratorType": {
            "type": ["array", "null"],
            "items": {
              "type": "string"
            }
          },
          "appliedFilterSearchSavedWith": {
            "type": "integer",
            "minimum": 0
          },
          "isPinned": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}

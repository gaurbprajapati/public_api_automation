{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["meta", "data"],
  "properties": {
    "meta": {
      "type": "object",
      "required": ["message", "requestUuid", "responseType", "timestamp", "status"],
      "properties": {
        "message": {
          "type": "string",
          "enum": ["Job quick view data fetched successfully"]
        },
        "requestUuid": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "responseType": {
          "type": "object",
          "required": ["context", "code"],
          "properties": {
            "context": {
              "type": "string",
              "enum": ["Request is successful"]
            },
            "code": {
              "type": "integer",
              "enum": [103]
            }
          }
        },
        "timestamp": {
          "type": "string",
          "pattern": "^\\d{2}-\\d{2}-\\d{4} \\d{2}:\\d{2}:\\d{2}$"
        },
        "status": {
          "type": "integer",
          "enum": [200]
        }
      }
    },
    "data": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "allJobs",
          "myJobs",
          "openJobs",
          "closedJobs",
          "onHoldJobs",
          "cancelledJobs",
          "archivedJobs",
          "notInAnyHotlist"
        ],
        "properties": {
          "allJobs": {
            "type": "integer",
            "minimum": 0,
            "description": "Total number of jobs in the account"
          },
          "myJobs": {
            "type": "integer",
            "minimum": 0,
            "description": "Number of jobs owned by the current user"
          },
          "openJobs": {
            "type": "integer",
            "minimum": 0,
            "description": "Number of jobs with open status"
          },
          "closedJobs": {
            "type": "integer",
            "minimum": 0,
            "description": "Number of jobs with closed status"
          },
          "onHoldJobs": {
            "type": "integer",
            "minimum": 0,
            "description": "Number of jobs on hold"
          },
          "cancelledJobs": {
            "type": "integer",
            "minimum": 0,
            "description": "Number of cancelled jobs"
          },
          "archivedJobs": {
            "type": "integer",
            "minimum": 0,
            "description": "Number of archived jobs"
          },
          "notInAnyHotlist": {
            "type": "integer",
            "minimum": 0,
            "description": "Number of jobs not in any hotlist"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}

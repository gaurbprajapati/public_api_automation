{
  "$schema": "http://json-schema.org/draft-04/schema#",
  "type": "object",
  "properties": {
    "current_page": {
      "type": "integer"
    },
    "data": {
      "type": "array",
      "items": [
        {
          "type": "object",
          "properties": {
            "status": {
              "type": "object",
              "properties": {
                "status_id": {
                  "type": "integer"
                },
                "label": {
                  "type": "string"
                }
              },
              "required": [
                "status_id",
                "label"
              ]
            },
            "remark": {
              "type": [
                "null",
                "string"
            ]
            },
            "stage_date": {
              "type": "string"
            },
            "updated_on": {
              "type": "string"
            },
            "updated_by": {
              "type": "integer"
            }
          },
          "required": [
            "status",
            "remark",
            "stage_date",
            "updated_on",
            "updated_by"
          ]
        }
      ]
    },
    "first_page_url": {
      "type": "string"
    },
    "from": {
      "type": "integer"
    },
    "next_page_url": {
      "type": [
        "null",
        "string"
      ]
    },
    "path": {
      "type": "string"
    },
    "per_page": {
      "type": "integer"
    },
    "prev_page_url": {
      "type": [
        "null",
        "string"
      ]
    },
    "to": {
      "type": "integer"
    }
  },
  "required": [
    "current_page",
    "data",
    "first_page_url",
    "from",
    "next_page_url",
    "path",
    "per_page",
    "prev_page_url",
    "to"
  ]
}
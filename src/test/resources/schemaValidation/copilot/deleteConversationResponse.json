{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["data", "meta"],
  "properties": {
    "data": {
      "type": "null"
    },
    "meta": {
      "type": "object",
      "required": ["request_UUID", "message", "message_type", "status"],
      "properties": {
        "request_UUID": {
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "message_type": {
          "type": "string"
        },
        "status": {
          "type": "integer"
        }
      }
    }
  }
}


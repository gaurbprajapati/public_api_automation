{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["data", "meta"],
  "properties": {
    "data": {
      "type": "object",
      "required": ["id", "title", "prompt", "user_id", "account_id", "pinned", "created_by", "updated_by", "created_on", "updated_on"],
      "properties": {
        "id": {
          "type": "integer"
        },
        "title": {
          "type": "string"
        },
        "prompt": {
          "type": "string"
        },
        "user_id": {
          "type": "integer"
        },
        "account_id": {
          "type": "integer"
        },
        "pinned": {
          "type": ["integer", "boolean"]
        },
        "created_by": {
          "type": "integer"
        },
        "updated_by": {
          "type": "integer"
        },
        "created_on": {
          "type": "integer"
        },
        "updated_on": {
          "type": "integer"
        }
      }
    },
    "meta": {
      "type": "object",
      "required": ["request_UUID", "message", "message_type", "status"],
      "properties": {
        "request_UUID": {
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "message_type": {
          "type": "string"
        },
        "status": {
          "type": "integer"
        }
      }
    }
  }
}


{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["meta", "data", "errors"],
  "properties": {
    "meta": {
      "type": "object",
      "required": ["message", "requestUuid", "responseType", "timestamp", "status"],
      "properties": {
        "message": {
          "type": ["string", "null"]
        },
        "requestUuid": {
          "type": "string"
        },
        "responseType": {
          "type": "object",
          "required": ["context", "code"],
          "properties": {
            "context": {
              "type": "string",
              "const": "Error while processing request"
            },
            "code": {
              "type": "integer",
              "const": 101
            }
          }
        },
        "timestamp": {
          "type": "string"
        },
        "status": {
          "type": "integer",
          "const": 401
        }
      }
    },
    "data": {
      "type": ["object", "null"]
    },
    "errors": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["message", "errorType"],
        "properties": {
          "message": {
            "type": "string",
            "const": "Unauthorized"
          },
          "errorType": {
            "type": "object",
            "required": ["context", "code"],
            "properties": {
              "context": {
                "type": "string",
                "const": "Generic Error"
              },
              "code": {
                "type": "integer",
                "const": 202
              }
            }
          }
        }
      }
    }
  }
}


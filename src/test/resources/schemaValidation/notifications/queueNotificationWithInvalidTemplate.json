{
    "$schema": "http://json-schema.org/draft-04/schema#",
    "type": "object",
    "properties": {
      "data": {
        "type": "null"
      },
      "meta": {
        "type": "object",
        "properties": {
          "request_UUID": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "message_type": {
            "type": "string"
          },
          "status": {
            "type": "integer"
          }
        },
        "required": [
          "request_UUID",
          "message",
          "message_type",
          "status"
        ]
      },
      "errors": {

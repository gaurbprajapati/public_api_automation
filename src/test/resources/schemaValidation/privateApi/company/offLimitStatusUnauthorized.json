{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Company Off-Limit Status Unauthorized Response Schema",
  "type": "object",
  "required": ["meta", "data", "errors"],
  "properties": {
    "meta": {
      "type": "object",
      "required": ["message", "requestUuid", "responseType", "timestamp", "status"],
      "properties": {
        "message": {
          "type": "string",
          "enum": ["Unauthorised access"]
        },
        "requestUuid": {
          "type": "string"
        },
        "responseType": {
          "type": "object",
          "required": ["context", "code"],
          "properties": {
            "context": {
              "type": "string",
              "enum": ["Warning"]
            },
            "code": {
              "type": "integer",
              "enum": [104]
            }
          }
        },
        "timestamp": {
          "type": "string"
        },
        "status": {
          "type": "integer",
          "enum": [401]
        }
      }
    },
    "data": {
      "type": "string"
    },
    "errors": {
      "type": "array"
    }
  }
}


{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Company Off-Limit Status Null Data Response Schema",
  "type": "object",
  "required": ["meta", "data"],
  "properties": {
    "meta": {
      "type": "object",
      "required": ["message", "requestUuid", "responseType", "timestamp", "status"],
      "properties": {
        "message": {
          "type": "string",
          "enum": ["OffLimitStatus fetched successfully."]
        },
        "requestUuid": {
          "type": "string",
          "format": "uuid"
        },
        "responseType": {
          "type": "object",
          "required": ["context", "code"],
          "properties": {
            "context": {
              "type": "string",
              "enum": ["Request is successful"]
            },
            "code": {
              "type": "integer",
              "enum": [103]
            }
          }
        },
        "timestamp": {
          "type": "string"
        },
        "status": {
          "type": "integer",
          "enum": [200]
        }
      }
    },
    "data": {
      "type": "null"
    }
  }
}


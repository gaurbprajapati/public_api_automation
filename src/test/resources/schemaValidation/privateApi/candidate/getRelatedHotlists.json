{
  "$schema": "http://json-schema.org/draft-04/schema#",
  "type": "object",
  "properties": {
    "meta": {
      "type": "object",
      "properties": {
        "message": {
          "type": "string"
        },
        "requestUuid": {
          "type": "string"
        },
        "responseType": {
          "type": "object",
          "properties": {
            "context": {
              "type": "string"
            },
            "code": {
              "type": "integer"
            }
          },
          "required": [
            "context",
            "code"
          ]
        },
        "timestamp": {
          "type": "string"
        },
        "status": {
          "type": "integer"
        }
      },
      "required": [
        "message",
        "requestUuid",
        "responseType",
        "timestamp",
        "status"
      ]
    },
    "data": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer"
          },
          "name": {
            "type": "string"
          },
          "createdOn": {
            "type": "integer"
          },
          "updatedOn": {
            "type": "integer"
          },
          "ownerId": {
            "type": "integer"
          },
          "ownerName": {
            "type": "string"
          },
          "ownerPhoto": {
            "type": ["string", "null"]
          },
          "entityName": {
            "type": "string"
          },
          "shared": {
            "type": "integer"
          },
          "accountId": {
            "type": "integer"
          },
          "updatedBy": {
            "type": "integer"
          }
        },
        "required": [
          "id",
          "name",
          "createdOn",
          "updatedOn",
          "ownerId",
          "ownerName",
          "entityName",
          "shared",
          "accountId",
          "updatedBy"
        ]
      }
    }
  },
  "required": [
    "meta",
    "data"
  ]
}

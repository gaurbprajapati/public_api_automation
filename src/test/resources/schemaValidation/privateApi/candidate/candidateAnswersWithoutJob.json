{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["meta", "data"],
  "properties": {
    "meta": {
      "type": "object",
      "required": ["message", "requestUuid", "responseType", "timestamp", "status"],
      "properties": {
        "message": {
          "type": "string",
          "enum": ["Candidate answers fetched successfully"]
        },
        "requestUuid": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "responseType": {
          "type": "object",
          "required": ["context", "code"],
          "properties": {
            "context": {
              "type": "string",
              "enum": ["Request is successful"]
            },
            "code": {
              "type": "integer",
              "enum": [103]
            }
          },
          "additionalProperties": false
        },
        "timestamp": {
          "type": "string",
          "pattern": "^\\d{2}-\\d{2}-\\d{4} \\d{2}:\\d{2}:\\d{2}$"
        },
        "status": {
          "type": "integer",
          "enum": [200]
        }
      },
      "additionalProperties": false
    },
    "data": {
      "type": "object",
      "required": ["allQuestionAnswerDto", "allAssociatedJobQuestionAnswerDto"],
      "properties": {
        "allQuestionAnswerDto": {
          "type": "object",
          "required": ["questionAnswerDtos"],
          "properties": {
            "questionAnswerDtos": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["question", "questionId", "readMore"],
                "properties": {
                  "answer": {
                    "type": "string"
                  },
                  "answerId": {
                    "type": ["integer", "null"]
                  },
                  "jobId": {
                    "type": ["integer", "null"]
                  },
                  "question": {
                    "type": "string",
                    "minLength": 1
                  },
                  "questionId": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "readMore": {
                    "type": "boolean"
                  }
                },
                "additionalProperties": false
              }
            }
          },
          "additionalProperties": false
        },
        "allAssociatedJobQuestionAnswerDto": {
          "type": "null"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}

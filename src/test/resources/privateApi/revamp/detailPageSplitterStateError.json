{
  "$schema": "http://json-schema.org/draft-04/schema#",
  "type": "object",
  "properties": {
    "silent_progress": {
      "type": "boolean"
    },
    "message": {
      "type": "string"
    },
    "message_type": {
      "type": "string",
      "enum": [
        "is-danger",
        "is_danger"
      ]
    },
    "data": {
      "type": "array",
      "items": {}
    },
    "user": {
      "type": [
        "string",
        "null"
      ]
    },
    "notifications": {
      "type": "array",
      "items": {}
    },
    "status": {
      "type": "string",
      "enum": [
        "fail"
      ]
    },
    "application_version": {
      "type": "string"
    },
    "recaptcha_site_key": {
      "type": "string"
    },
    "start_time": {
      "type": "number"
    },
    "end_time": {
      "type": "number"
    },
    "time_to_output": {
      "type": "number"
    }
  },
  "required": [
    "silent_progress",
    "message",
    "message_type",
    "data",
    "notifications",
    "status",
    "application_version",
    "recaptcha_site_key",
    "start_time",
    "end_time",
    "time_to_output"
  ]
}

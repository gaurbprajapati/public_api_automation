{
  "$schema": "http://json-schema.org/draft-04/schema#",
  "type": "object",
  "properties": {
    "silent_progress": {
      "type": "boolean"
    },
    "message": {
      "type": "string"
    },
    "message_type": {
      "type": "string",
      "enum": [
        "is-success",
        "is-danger",
        "is_danger"
      ]
    },
    "data": {
      "type": "object",
      "properties": {
        "user_id": {
          "type": "integer"
        },
        "account_id": {
          "type": "integer"
        },
        "splitter_state": {
          "type": "object",
          "properties": {
            "detail_page_splitter_points": {
              "type": "number"
            },
            "activity_sidebar_splitter_points": {
              "type": "number"
            }
          },
          "required": [
            "detail_page_splitter_points",
            "activity_sidebar_splitter_points"
          ]
        }
      },
      "required": [
        "user_id",
        "account_id",
        "splitter_state"
      ]
    },
    "user": {
      "type": "string"
    },
    "notifications": {
      "type": "array",
      "items": {}
    },
    "status": {
      "type": "string",
      "enum": [
        "success",
        "fail"
      ]
    },
    "application_version": {
      "type": "string"
    },
    "recaptcha_site_key": {
      "type": "string"
    },
    "start_time": {
      "type": "number"
    },
    "end_time": {
      "type": "number"
    },
    "time_to_output": {
      "type": "number"
    }
  },
  "required": [
    "silent_progress",
    "message",
    "message_type",
    "data",
    "user",
    "notifications",
    "status",
    "application_version",
    "recaptcha_site_key",
    "start_time",
    "end_time",
    "time_to_output"
  ]
}

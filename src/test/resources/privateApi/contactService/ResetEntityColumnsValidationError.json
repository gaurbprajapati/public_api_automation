{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "meta": {
      "type": "object",
      "properties": {
        "message": {
          "type": ["string", "null"]
        },
        "requestUuid": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "responseType": {
          "type": "object",
          "properties": {
            "context": {
              "type": "string",
              "enum": ["Error while processing request"]
            },
            "code": {
              "type": "integer",
              "enum": [101]
            }
          },
          "required": ["context", "code"]
        },
        "timestamp": {
          "type": "string",
          "pattern": "^\\d{2}-\\d{2}-\\d{4} \\d{2}:\\d{2}:\\d{2}$"
        },
        "status": {
          "type": "integer",
          "enum": [400]
        }
      },
      "required": ["message", "requestUuid", "responseType", "timestamp", "status"]
    },
    "data": {
      "type": "null"
    },
    "errors": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "message": {
            "type": "string"
          },
          "errorType": {
            "type": "object",
            "properties": {
              "context": {
                "type": "string",
                "enum": ["Validation Error"]
              },
              "code": {
                "type": "integer",
                "enum": [201]
              }
            },
            "required": ["context", "code"]
          }
        },
        "required": ["message", "errorType"]
      },
      "minItems": 1
    }
  },
  "required": ["meta", "data", "errors"]
}

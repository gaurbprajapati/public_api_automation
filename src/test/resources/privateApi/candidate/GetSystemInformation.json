{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "meta": {
      "type": "object",
      "properties": {
        "message": {
          "type": "string",
          "enum": ["Candidate System Information fetched successfully"]
        },
        "requestUuid": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "responseType": {
          "type": "object",
          "properties": {
            "context": {
              "type": "string",
              "enum": ["Request is successful"]
            },
            "code": {
              "type": "integer",
              "enum": [103]
            }
          },
          "required": ["context", "code"]
        },
        "timestamp": {
          "type": "string",
          "pattern": "^\\d{2}-\\d{2}-\\d{4} \\d{2}:\\d{2}:\\d{2}$"
        },
        "status": {
          "type": "integer",
          "enum": [200]
        }
      },
      "required": ["message", "requestUuid", "responseType", "timestamp", "status"]
    },
    "data": {
      "type": "object",
      "properties": {
        "lastUpdatedOn": {
          "type": ["integer", "null"]
        },
        "lastUpdatedBy": {
          "type": ["integer", "null"]
        },
        "lastUpdatedByName": {
          "type": "string"
        },
        "createdOn": {
          "type": ["integer", "null"]
        },
        "createdBy": {
          "type": ["integer", "null"]
        },
        "createdByName": {
          "type": "string"
        },
        "lastEmailSentOn": {
          "type": ["integer", "null"]
        },
        "lastEmailSentBy": {
          "type": ["integer", "null"]
        },
        "lastEmailSentByName": {
          "type": "string"
        },
        "lastCallLogAddedOn": {
          "type": ["integer", "null"]
        },
        "lastCallLogAddedBy": {
          "type": ["integer", "null"]
        },
        "lastCallLogAddedByName": {
          "type": "string"
        },
        "lastSmsSentOn": {
          "type": ["integer", "null"]
        },
        "lastSmsSentBy": {
          "type": ["integer", "null"]
        },
        "lastSmsSentByName": {
          "type": "string"
        }
      },
      "required": [
        "lastUpdatedOn",
        "lastUpdatedBy",
        "lastUpdatedByName",
        "createdOn",
        "createdBy",
        "createdByName",
        "lastEmailSentOn",
        "lastEmailSentBy",
        "lastEmailSentByName",
        "lastCallLogAddedOn",
        "lastCallLogAddedBy",
        "lastCallLogAddedByName",
        "lastSmsSentOn",
        "lastSmsSentBy",
        "lastSmsSentByName"
      ]
    }
  },
  "required": ["meta", "data"]
}


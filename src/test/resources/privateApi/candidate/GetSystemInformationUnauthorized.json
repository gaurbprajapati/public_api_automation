{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "meta": {
      "type": "object",
      "properties": {
        "message": {
          "type": "string",
          "enum": ["Unauthorised access"]
        },
        "requestUuid": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "responseType": {
          "type": "object",
          "properties": {
            "context": {
              "type": "string",
              "enum": ["Warning"]
            },
            "code": {
              "type": "integer",
              "enum": [104]
            }
          },
          "required": ["context", "code"]
        },
        "timestamp": {
          "type": "string",
          "pattern": "^\\d{2}-\\d{2}-\\d{4} \\d{2}:\\d{2}:\\d{2}$"
        },
        "status": {
          "type": "integer",
          "enum": [401]
        }
      },
      "required": ["message", "requestUuid", "responseType", "timestamp", "status"]
    },
    "data": {
      "type": "string",
      "enum": ["Missing bearer token in header", "Invalid or expired token"]
    },
    "errors": {
      "type": "array",
      "items": {}
    }
  },
  "required": ["meta", "data", "errors"]
}


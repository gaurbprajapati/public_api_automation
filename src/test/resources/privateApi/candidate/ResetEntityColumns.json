{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "meta": {
      "type": "object",
      "properties": {
        "message": {
          "type": "string",
          "enum": ["Entity Column Fetched Successfully"]
        },
        "requestUuid": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "responseType": {
          "type": "object",
          "properties": {
            "context": {
              "type": "string",
              "enum": ["Request is successful"]
            },
            "code": {
              "type": "integer",
              "enum": [103]
            }
          },
          "required": ["context", "code"]
        },
        "timestamp": {
          "type": "string",
          "pattern": "^\\d{2}-\\d{2}-\\d{4} \\d{2}:\\d{2}:\\d{2}$"
        },
        "status": {
          "type": "integer",
          "enum": [200]
        }
      },
      "required": ["message", "requestUuid", "responseType", "timestamp", "status"]
    },
    "data": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "columns": {
            "type": "object",
            "additionalProperties": true
          }
        },
        "required": ["columns"],
        "additionalProperties": true
      },
      "minItems": 1
    }
  },
  "required": ["meta", "data"]
}


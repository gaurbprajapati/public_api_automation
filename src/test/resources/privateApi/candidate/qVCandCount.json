{
    "$schema": "http://json-schema.org/draft-04/schema#",
    "type": "object",
    "properties": {
      "meta": {
        "type": "object",
        "properties": {
          "message": {
            "type": "string"
          },
          "requestUuid": {
            "type": "string"
          },
          "responseType": {
            "type": "object",
            "properties": {
              "context": {
                "type": "string"
              },
              "code": {
                "type": "integer"
              }
            },
            "required": [
              "context",
              "code"
            ]
          },
          "timestamp": {
            "type": "string"
          },
          "status": {
            "type": "integer"
          }
        },
        "required": [
          "message",
          "requestUuid",
          "responseType",
          "timestamp",
          "status"
        ]
      },
      "data": {
        "type": "array",
        "items": [
          {
            "type": "object",
            "properties": {
              "allCandidates": {
                "type": "integer"
              },
              "myCandidates": {
                "type": "integer"
              },
              "allWebsiteApplicants": {
                "type": "integer"
              },
              "myWebsiteApplicants": {
                "type": "integer"
              },
              "notInAnyHotlist": {
                "type": "integer"
              },
              "offLimitCandidates": {
                "type": "integer"
              }
            },
            "required": [
              "allCandidates",
              "myCandidates",
              "allWebsiteApplicants",
              "myWebsiteApplicants",
              "notInAnyHotlist",
              "offLimitCandidates"
            ]
          }
        ]
      }
    },
    "required": [
      "meta",
      "data"
    ]
  }
{
  "$schema": "http://json-schema.org/draft-04/schema#",
  "type": "object",
  "properties": {
    "meta": {
      "type": "object",
      "properties": {
        "message": {
          "type": "string"
        },
        "requestUuid": {
          "type": "string"
        },
        "responseType": {
          "type": "object",
          "properties": {
            "context": {
              "type": "string"
            },
            "code": {
              "type": "integer"
            }
          },
          "required": [
            "context",
            "code"
          ]
        },
        "timestamp": {
          "type": "string"
        },
        "status": {
          "type": "integer"
        }
      },
      "required": [
        "message",
        "requestUuid",
        "responseType",
        "timestamp",
        "status"
      ]
    },
    "data": {
      "type": "array",
      "items": [
        {
          "type": "object",
          "properties": {
            "instituteName": {
              "type": "string"
            },
            "educationHistories": {
              "type": "array",
              "items": [
                {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "integer"
                    },
                    "candidateId": {
                      "type": "integer"
                    },
                    "instituteName": {
                      "type": "string"
                    },
                    "educationalQualification": {
                      "type": "string"
                    },
                    "educationalSpecialization": {
                      "type": "string"
                    },
                    "grade": {
                      "type": "string"
                    },
                    "educationLocation": {
                      "type": "string"
                    },
                    "educationStartDate": {
                      "type": "integer"
                    },
                    "educationEndDate": {
                      "type": "integer"
                    },
                    "educationDescription": {
                      "type": "string"
                    },
                    "candidateSlug": {
                      "type": "string"
                    },
                    "isManuallyAdded": {
                      "type": "boolean"
                    },
                    "createdBy": {
                      "type": "integer"
                    },
                    "updatedBy": {
                      "type": "integer"
                    },
                    "createdOn": {
                      "type": "integer"
                    },
                    "updatedOn": {
                      "type": "integer"
                    }
                  },
                  "required": [
                    "id",
                    "candidateId",
                    "instituteName",
                    "educationalQualification",
                    "educationalSpecialization",
                    "grade",
                    "educationLocation",
                    "educationStartDate",
                    "educationEndDate",
                    "educationDescription",
                    "candidateSlug",
                    "isManuallyAdded",
                    "createdBy",
                    "updatedBy",
                    "createdOn",
                    "updatedOn"
                  ]
                }
              ]
            }
          },
          "required": [
            "instituteName",
            "educationHistories"
          ]
        }
      ]
    }
  },
  "required": [
    "meta",
    "data"
  ]
}
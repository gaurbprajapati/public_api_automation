{
  "$schema": "http://json-schema.org/draft-04/schema#",
  "type": "object",
  "properties": {
    "silent_progress": {
      "type": "boolean"
    },
    "message": {
      "type": "string",
      "description": "Can be '0' for own view or descriptive message for others view"
    },
    "message_type": {
      "type": "string",
      "enum": [
        "is-success",
        "is_danger"
      ]
    },
    "data": {
      "type": "array"
    },
    "notifications": {
      "type": "array"
    },
    "user": {
      "type": "object",
      "properties": {
        "accountid": {
          "type": "integer"
        },
        "role": {
          "type": "string"
        }
      },
      "required": [
        "accountid"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "success",
        "fail"
      ]
    },
    "action_name": {
      "type": "string",
      "description": "Can be 'State Saved' for success or empty string for failures"
    },
    "actionid": {
      "type": [
        "integer",
        "string"
      ],
      "description": "Can be integer for success or empty string for failures"
    },
    "intercom": {
      "type": [
        "null",
        "object"
      ]
    },
    "recaptcha_site_key": {
      "type": "string"
    }
  },
  "required": [
    "silent_progress",
    "message",
    "message_type",
    "data",
    "notifications",
    "user",
    "status",
    "action_name",
    "actionid"
  ]
}

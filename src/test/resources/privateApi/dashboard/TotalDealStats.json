{
	"$schema": "http://json-schema.org/draft-04/schema#",
	"type": "object",
	"properties": {
		"silent_progress": {
			"type": "boolean"
		},
		"message": {
			"type": "string"
		},
		"message_type": {
			"type": "string"
		},
		"data": {
			"type": "object",
			"properties": {
				"total_count": {
					"type": "integer"
				},
				"filtered_count": {
					"type": "integer"
				},
				"records": {
					"type": "object",
					"properties": {
						"total_data": {
							"type": "object",
							"properties": {
								"total_deal_weighted": {
									"type": "integer"
								},
								"total_pipeline": {
									"type": "integer"
								},
								"deal_won": {
									"type": "integer"
								},
								"deal_lost": {
									"type": "integer"
								},
								"total_deals": {
									"type": "integer"
								},
								"total_split": {
									"type": "integer"
								},
								"total_weighted_split": {
									"type": "integer"
								}
							},
							"required": [
								"total_deal_weighted",
								"total_pipeline",
								"deal_won",
								"deal_lost",
								"total_deals",
								"total_split",
								"total_weighted_split"
							]
						},
						"deal_stats_data": {
							"type": "array",
							"items": [
								{
									"type": "object",
									"properties": {
										"id": {
											"type": "integer"
										},
										"label": {
											"type": "string"
										},
										"total_count": {
											"type": "integer"
										},
										"deal_weighted_amount": {
											"type": "integer"
										},
										"deal_amount": {
											"type": "string"
										},
										"split": {
											"type": "integer"
										},
										"weighted_split": {
											"type": "integer"
										}
									},
									"required": [
										"id",
										"label",
										"total_count",
										"deal_weighted_amount",
										"deal_amount",
										"split",
										"weighted_split"
									]
								},
								{
									"type": "object",
									"properties": {
										"id": {
											"type": "integer"
										},
										"label": {
											"type": "string"
										},
										"total_count": {
											"type": "integer"
										},
										"deal_weighted_amount": {
											"type": "integer"
										},
										"deal_amount": {
											"type": "string"
										},
										"split": {
											"type": "integer"
										},
										"weighted_split": {
											"type": "integer"
										}
									},
									"required": [
										"id",
										"label",
										"total_count",
										"deal_weighted_amount",
										"deal_amount",
										"split",
										"weighted_split"
									]
								}
							]
						}
					},
					"required": [
						"total_data",
						"deal_stats_data"
					]
				}
			},
			"required": [
				"total_count",
				"filtered_count",
				"records"
			]
		},
		"user": {
			"type": "string"
		},
		"notifications": {
			"type": "array",
			"items": {}
		},
		"status": {
			"type": "string"
		},
		"application_version": {
			"type": "string"
		},
		"recaptcha_site_key": {
			"type": "string"
		},
		"start_time": {
			"type": "number"
		},
		"end_time": {
			"type": "number"
		},
		"time_to_output": {
			"type": "number"
		}
	},
	"required": [
		"silent_progress",
		"message",
		"message_type",
		"data",
		"user",
		"notifications",
		"status",
		"application_version",
		"recaptcha_site_key",
		"start_time",
		"end_time",
		"time_to_output"
	]
}
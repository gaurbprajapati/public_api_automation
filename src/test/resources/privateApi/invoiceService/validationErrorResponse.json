{
	"$schema": "http://json-schema.org/draft-04/schema#",
	"title": "Invoice Service Validation Error Response",
	"type": "object",
	"properties": {
		"meta": {
			"type": "object",
			"properties": {
				"message": {
					"type": ["string", "null"]
				},
				"requestUuid": {
					"type": "string"
				},
				"responseType": {
					"type": "object",
					"properties": {
						"context": {
							"type": "string"
						},
						"code": {
							"type": "integer"
						}
					},
					"required": [
						"context",
						"code"
					]
				},
				"timestamp": {
					"type": "string"
				},
				"status": {
					"type": "integer"
				}
			},
			"required": [
				"requestUuid",
				"responseType",
				"timestamp",
				"status"
			]
		},
		"data": {
			"type": "null"
		},
		"errors": {
			"type": "array",
			"items": {
				"type": "object",
				"properties": {
					"message": {
						"type": "string"
					},
					"errorType": {
						"type": "object",
						"properties": {
							"context": {
								"type": "string"
							},
							"code": {
								"type": "integer"
							}
						},
						"required": [
							"context",
							"code"
						]
					}
				},
				"required": [
					"message",
					"errorType"
				]
			}
		}
	},
	"required": [
		"meta",
		"data",
		"errors"
	]
}

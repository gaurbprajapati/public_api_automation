{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["meta", "data"],
  "properties": {
    "meta": {
      "type": "object",
      "required": ["message", "requestUuid", "responseType", "timestamp", "status"],
      "properties": {
        "message": {
          "type": "string"
        },
        "requestUuid": {
          "type": "string"
        },
        "responseType": {
          "type": "object",
          "required": ["context", "code"],
          "properties": {
            "context": {
              "type": "string"
            },
            "code": {
              "type": "integer"
            }
          }
        },
        "timestamp": {
          "type": "string"
        },
        "status": {
          "type": "integer"
        }
      }
    },
    "data": {
      "type": "object",
      "required": ["candidate", "company", "contact", "job", "deals"],
      "properties": {
        "candidate": {
          "type": "object",
          "patternProperties": {
            "^[a-zA-Z0-9]+$": {
              "type": "object",
              "properties": {
                "offLimitStatusId": {
                  "type": ["integer", "null"]
                },
                "offLimitReason": {
                  "type": ["string", "null"]
                },
                "offLimitEndDate": {
                  "type": ["string", "null"]
                },
                "offLimitStartDate": {
                  "type": ["string", "null"]
                },
                "statusLabel": {
                  "type": ["string", "null"]
                },
                "backgroundColorHex": {
                  "type": ["string", "null"]
                },
                "textColorHex": {
                  "type": ["string", "null"]
                },
                "markedByName": {
                  "type": ["string", "null"]
                },
                "name": {
                  "type": "string"
                },
                "currentOrgName": {
                  "type": ["string", "null"]
                },
                "title": {
                  "type": ["string", "null"]
                },
                "initial": {
                  "type": "string"
                },
                "email": {
                  "type": ["string", "null"]
                },
                "photo": {
                  "type": ["string", "null"]
                },
                "slug": {
                  "type": "string"
                },
                "serialNumber": {
                  "type": "integer"
                },
                "candidateId": {
                  "type": "integer"
                },
                "emailOptedOut": {
                  "type": ["boolean", "null"]
                },
                "createdBy": {
                  "type": ["integer", "null"]
                }
              }
            }
          }
        },
        "company": {
          "type": "object"
        },
        "contact": {
          "type": "object"
        },
        "job": {
          "type": "object"
        },
        "deals": {
          "type": "object"
        }
      }
    }
  }
}

            "type": "object",
            "properties": {
              "context": {
                "type": "string"
              },
              "code": {
                "type": "integer"
              }
            },
            "required": [
              "context",
              "code"
            ]
          },
          "timestamp": {
            "type": "string"
          },
          "status": {
            "type": "integer"
          }
        },
        "required": [

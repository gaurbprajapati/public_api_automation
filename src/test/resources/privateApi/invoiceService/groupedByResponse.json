{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["meta", "data"],
  "properties": {
    "meta": {
      "type": "object",
      "required": ["message", "requestUuid", "responseType", "timestamp", "status"],
      "properties": {
        "message": {
          "type": "string"
        },
        "requestUuid": {
          "type": "string"
        },
        "responseType": {
          "type": "object",
          "required": ["context", "code"],
          "properties": {
            "context": {
              "type": "string"
            },
            "code": {
              "type": "integer"
            }
          }
        },
        "timestamp": {
          "type": "string"
        },
        "status": {
          "type": "integer"
        }
      }
    },
    "data": {
      "type": "null"
    }
  }
}

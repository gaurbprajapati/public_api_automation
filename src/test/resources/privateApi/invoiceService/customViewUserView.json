{
	"$schema": "http://json-schema.org/draft-04/schema#",
	"title": "Custom View User View API response",
	"type": "object",
	"properties": {
		"meta": {
			"type": "object",
			"properties": {
				"message": {
					"type": "string"
				},
				"requestUuid": {
					"type": "string"
				},
				"responseType": {
					"type": "object",
					"properties": {
						"context": {
							"type": "string"
						},
						"code": {
							"type": "integer"
						}
					},
					"required": [
						"context",
						"code"
					]
				},
				"timestamp": {
					"type": "string"
				},
				"status": {
					"type": "integer"
				}
			},
			"required": [
				"message",
				"requestUuid",
				"responseType",
				"timestamp",
				"status"
			]
		},
		"data": {
			"type": "object",
			"properties": {
				"accountId": {
					"type": "integer"
				},
				"entityId": {
					"type": "integer"
				},
				"listActions": {
					"type": "object",
					"properties": {
						"setting": {
							"type": "array"
						},
						"meta": {
							"type": "object",
							"properties": {
								"updatedBy": {
									"type": "integer"
								},
								"updatedOn": {
									"type": "integer"
								}
							},
							"required": [
								"updatedBy",
								"updatedOn"
							]
						}
					},
					"required": [
						"setting",
						"meta"
					]
				},
				"groupedBy": {
					"type": "string"
				}
			},
			"required": [
				"accountId",
				"entityId",
				"listActions",
				"groupedBy"
			]
		}
	},
	"required": [
		"meta",
		"data"
	]
}

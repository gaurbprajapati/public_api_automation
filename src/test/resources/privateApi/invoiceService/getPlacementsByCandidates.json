{
    "$schema": "http://json-schema.org/draft-04/schema#",
    "type": "object",
    "properties": {
      "meta": {
        "type": "object",
        "properties": {
          "message": {
            "type": "string"
          },
          "requestUuid": {
            "type": "string"
          },
          "responseType": {
            "type": "object",
            "properties": {
              "context": {
                "type": "string"
              },
              "code": {
                "type": "integer"
              }
            },
            "required": ["context", "code"]
          },
          "timestamp": {
            "type": "string"
          },
          "status": {
            "type": "integer"
          }
        },
        "required": ["message", "requestUuid", "responseType", "timestamp", "status"]
      },
      "data": {
        "type": "object",
        "properties": {
          "placementsByCandidates": {
            "type": "object",
            "patternProperties": {
              "^[0-9]+$": {
                "type": "object",
                "patternProperties": {
                  "^[0-9]+$": {
                    "type": "integer"
                  }
                },
                "additionalProperties": false
              }
            },
            "additionalProperties": false
          }
        },
        "required": ["placementsByCandidates"]
      }
    },
    "required": ["meta", "data"]
  }
  
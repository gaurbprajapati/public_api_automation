{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "current_page": {
      "type": "integer"
    },
    "data": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer"
          },
          "first_name": {
            "type": "string"
          },
          "last_name": {
            "type": "string"
          },
          "email": {
            "type": "string",
            "format": "email"
          },
          "contact_number": {
            "type": "string"
          },
          "avatar": {
            "type": [
              "string",
              "null"
            ]
          },
          "slug": {
            "type": "string"
          },
          "company_slug": {
            "type": "string"
          },
          "additional_company_slugs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "facebook": {
            "type": "string"
          },
          "twitter": {
            "type": "string"
          },
          "linkedin": {
            "type": "string"
          },
          "xing": {
            "type": [
              "string",
              "null"
            ]
          },
          "created_on": {
            "type": "string",
            "format": "date-time"
          },
          "updated_on": {
            "type": "string",
            "format": "date-time"
          },
          "city": {
            "type": [
              "string",
              "null"
            ]
          },
          "locality": {
            "type": [
              "string",
              "null"
            ]
          },
          "address": {
            "type": [
              "string",
              "null"
            ]
          },
          "designation": {
            "type": [
              "string",
              "null"
            ]
          },
          "stage_id": {
            "type": "integer"
          },
          "custom_fields": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "created_by": {
            "type": "integer"
          },
          "updated_by": {
            "type": "integer"
          },
          "owner": {
            "type": "integer"
          },
          "resource_url": {
            "type": "string"
          },
          "is_email_opted_out": {
            "type": "string",
            "enum": [
              "true",
              "false"
            ]
          },
          "email_opt_out_source": {
            "type": [
              "string",
              "null"
            ]
          },
          "status_label": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "first_name",
          "last_name",
          "email",
          "contact_number",
          "slug",
          "company_slug",
          "created_on",
          "updated_on",
          "stage_id",
          "created_by",
          "updated_by",
          "owner",
          "resource_url",
          "is_email_opted_out",
          "status_label"
        ]
      }
    },
    "first_page_url": {
      "type": "string"
    },
    "from": {
      "type": "integer"
    },
    "next_page_url": {
      "type": [
        "string",
        "null"
      ]
    },
    "path": {
      "type": "string"
    },
    "per_page": {
      "type": "integer"
    },
    "prev_page_url": {
      "type": [
        "string",
        "null"
      ]
    },
    "to": {
      "type": "integer"
    }
  },
  "required": [
    "current_page",
    "data",
    "first_page_url",
    "from",
    "path",
    "per_page",
    "to"
  ]
}

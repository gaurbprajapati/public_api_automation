{
  "$schema": "http://json-schema.org/draft-04/schema#",
  "type": "object",
  "properties": {
    "meta": {
      "type": "object",
      "properties": {
        "message": {
          "type": "string"
        },
        "requestUuid": {
          "type": "string"
        },
        "responseType": {
          "type": "object",
          "properties": {
            "context": {
              "type": "string"
            },
            "code": {
              "type": "integer"
            }
          },
          "required": [
            "context",
            "code"
          ]
        },
        "timestamp": {
          "type": "string"
        },
        "status": {
          "type": "integer"
        }
      },
      "required": [
        "message",
        "requestUuid",
        "responseType",
        "timestamp",
        "status"
      ]
    },
    "data": {
      "type": "object",
      "properties": {
        "view": {
          "type": "object",
          "properties": {
            "visible": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "integer"
                  }
                },
                "required": [
                  "id"
                ]
              }
            },
            "hidden": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "integer"
                  }
                },
                "required": [
                  "id"
                ]
              }
            }
          },
          "required": [
            "visible",
            "hidden"
          ]
        },
        "viewType": {
          "type": "string"
        }
      },
      "required": [
        "view",
        "viewType"
      ]
    }
  },
  "required": [
    "meta",
    "data"
  ]
}
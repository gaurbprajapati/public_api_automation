{
    "$schema": "http://json-schema.org/draft-04/schema#",
    "type": "object",
    "properties": {
        "meta": {
            "type": "object",
            "properties": {
                "message": {
                    "type": "string"
                },
                "requestUuid": {
                    "type": "string"
                },
                "responseType": {
                    "type": "object",
                    "properties": {
                        "context": {
                            "type": "string"
                        },
                        "code": {
                            "type": "integer"
                        }
                    },
                    "required": [
                        "context",
                        "code"
                    ]
                },
                "timestamp": {
                    "type": "string"
                },
                "status": {
                    "type": "integer"
                }
            },
            "required": [
                "message",
                "requestUuid",
                "responseType",
                "timestamp",
                "status"
            ]
        },
        "data": {
            "type": "object",
            "properties": {
                "timesheetId": {
                    "type": "integer"
                },
                "workLogType": {
                    "type": "integer"
                },
                "timesheetFrequency": {
                    "type": "integer"
                },
                "calculateBreakTime": {
                    "type": "boolean"
                },
                "timeLogs": {
                    "type": "array",
                    "items": {
                        "type": "object",
                        "properties": {
                            "id": {
                                "type": "integer"
                            },
                            "timesheetId": {
                                "type": "integer"
                            },
                            "timesheetPeriod": {
                                "type": "string"
                            },
                            "date": {
                                "type": "integer"
                            },
                            "dayTypeId": {
                                "type": "integer"
                            },
                            "payData": {
                                "type": [
                                    "number",
                                    "null"
                                ]
                            },
                            "billData": {
                                "type": [
                                    "number",
                                    "null"
                                ]
                            },
                            "breakIntervals": {
                                "type": [
                                    "array",
                                    "null"
                                ]
                            }
                        },
                        "required": [
                            "id",
                            "timesheetId",
                            "timesheetPeriod",
                            "date",
                            "dayTypeId"
                        ]
                    }
                },
                "templateWorkDays": {
                    "type": "array",
                    "items": {
                        "type": "object",
                        "properties": {
                            "workDayId": {
                                "type": "integer"
                            },
                            "workTime": {
                                "type": "integer"
                            },
                            "workStartTime": {
                                "type": "integer"
                            },
                            "workEndTime": {
                                "type": "integer"
                            }
                        },
                        "required": [
                            "workDayId",
                            "workTime",
                            "workStartTime",
                            "workEndTime"
                        ]
                    }
                },
                "approvers": {
                    "type": "object",
                    "properties": {
                        "agencyIds": {
                            "type": "array",
                            "items": {
                                "type": "integer"
                            }
                        },
                        "clientIds": {
                            "type": "array",
                            "items": {
                                "type": "integer"
                            }
                        }
                    },
                    "required": [
                        "agencyIds",
                        "clientIds"
                    ]
                }
            },
            "required": [
                "timesheetId",
                "workLogType",
                "timesheetFrequency",
                "calculateBreakTime",
                "timeLogs",
                "templateWorkDays",
                "approvers"
            ]
        }
    },
    "required": [
        "meta",
        "data"
    ]
}
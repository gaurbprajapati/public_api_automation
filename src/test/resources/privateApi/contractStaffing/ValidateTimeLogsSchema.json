{
    "$schema": "http://json-schema.org/draft-04/schema#",
    "type": "object",
    "properties": {
        "meta": {
            "type": "object",
            "properties": {
                "message": {
                    "type": "string"
                },
                "requestUuid": {
                    "type": "string"
                },
                "responseType": {
                    "type": "object",
                    "properties": {
                        "context": {
                            "type": "string"
                        },
                        "code": {
                            "type": "integer"
                        }
                    },
                    "required": [
                        "context",
                        "code"
                    ]
                },
                "timestamp": {
                    "type": "string"
                },
                "status": {
                    "type": "integer"
                }
            },
            "required": [
                "message",
                "requestUuid",
                "responseType",
                "timestamp",
                "status"
            ]
        },
        "data": {
            "type": "object",
            "properties": {
                "errorData": {
                    "type": "array",
                    "items": {
                        "type": "object",
                        "properties": {
                            "message": {
                                "type": "string"
                            },
                            "errorType": {
                                "type": "string"
                            }
                        },
                        "required": [
                            "message",
                            "errorType"
                        ]
                    }
                },
                "timesheetSettingsMetaData": {
                    "type": "object",
                    "properties": {
                        "timesheetSettingId": {
                            "type": "integer"
                        },
                        "timesheetId": {
                            "type": "integer"
                        },
                        "workLogType": {
                            "type": "integer"
                        },
                        "timelogsMetaData": {
                            "type": "array",
                            "items": {
                                "type": "object",
                                "properties": {
                                    "timesheetId": {
                                        "type": "integer"
                                    },
                                    "calculateBreakTime": {
                                        "type": "boolean"
                                    },
                                    "breakTimeThreshold": {
                                        "type": [
                                            "integer",
                                            "null"
                                        ]
                                    },
                                    "templateWorkDays": {
                                        "type": "array",
                                        "items": {
                                            "type": "object",
                                            "properties": {
                                                "workDayId": {
                                                    "type": "integer"
                                                },
                                                "workTime": {
                                                    "type": "integer"
                                                },
                                                "workStartTime": {
                                                    "type": "integer"
                                                },
                                                "workEndTime": {
                                                    "type": "integer"
                                                }
                                            },
                                            "required": [
                                                "workDayId",
                                                "workTime",
                                                "workStartTime",
                                                "workEndTime"
                                            ]
                                        }
                                    }
                                },
                                "required": [
                                    "timesheetId",
                                    "calculateBreakTime",
                                    "templateWorkDays"
                                ]
                            }
                        },
                        "approvers": {
                            "type": "object",
                            "properties": {
                                "agencyIds": {
                                    "type": "array",
                                    "items": {
                                        "type": "integer"
                                    }
                                },
                                "clientIds": {
                                    "type": "array",
                                    "items": {
                                        "type": "integer"
                                    }
                                }
                            },
                            "required": [
                                "agencyIds",
                                "clientIds"
                            ]
                        }
                    },
                    "required": [
                        "timesheetSettingId",
                        "timesheetId",
                        "workLogType",
                        "timelogsMetaData",
                        "approvers"
                    ]
                },
                "timeLogs": {
                    "type": "array",
                    "items": {
                        "type": "object",
                        "properties": {
                            "id": {
                                "type": "integer"
                            },
                            "date": {
                                "type": "integer"
                            },
                            "dayTypeId": {
                                "type": "integer"
                            },
                            "workTime": {
                                "type": [
                                    "integer",
                                    "null"
                                ]
                            },
                            "workStartTime": {
                                "type": [
                                    "integer",
                                    "null"
                                ]
                            },
                            "workEndTime": {
                                "type": [
                                    "integer",
                                    "null"
                                ]
                            },
                            "breakTime": {
                                "type": [
                                    "integer",
                                    "null"
                                ]
                            },
                            "breakIntervals": {
                                "type": [
                                    "string",
                                    "null"
                                ]
                            },
                            "overTime": {
                                "type": [
                                    "integer",
                                    "null"
                                ]
                            },
                            "remark": {
                                "type": [
                                    "string",
                                    "null"
                                ]
                            },
                            "totalTime": {
                                "type": [
                                    "integer",
                                    "null"
                                ]
                            },
                            "timesheetId": {
                                "type": "integer"
                            },
                            "timesheetPeriod": {
                                "type": "string"
                            }
                        },
                        "required": [
                            "id",
                            "date",
                            "dayTypeId",
                            "timesheetId",
                            "timesheetPeriod"
                        ]
                    }
                }
            },
            "required": [
                "errorData",
                "timesheetSettingsMetaData",
                "timeLogs"
            ]
        }
    },
    "required": [
        "meta",
        "data"
    ]
}
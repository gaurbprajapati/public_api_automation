{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": [
    "silent_progress",
    "message",
    "message_type",
    "data",
    "status",
    "action_name",
    "actionid",
    "intercom"
  ],
  "properties": {
    "silent_progress": {
      "type": "boolean"
    },
    "message": {
      "type": "string"
    },
    "message_type": {
      "type": "string"
    },
    "data": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": ["fail"]
    },
    "action_name": {
      "type": "string"
    },
    "actionid": {
      "type": "string"
    },
    "intercom": {
      "type": "string"
    }
  }
}
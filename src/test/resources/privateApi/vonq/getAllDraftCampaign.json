{
	"$schema": "http://json-schema.org/draft-07/schema#",
	"type": "object",
	"properties": {
		"records": {
			"type": "object",
			"properties": {
				"current_page": {
					"type": "integer"
				},
				"data": {
					"type": "array",
					"items": {
						"type": "object",
						"properties": {
							"id": {
								"type": "integer"
							},
							"campaign_name": {
								"type": "string"
							},
							"job_id": {
								"type": "integer"
							},
							"account_id": {
								"type": "integer"
							},
							"created_on": {
								"type": "string",
								"format": "date-time"
							},
							"created_by": {
								"type": "integer"
							},
							"job_name": {
								"type": "string"
							},
							"job_slug": {
								"type": "string"
							},
							"created_by_name": {
								"type": "string"
							}
						},
						"required": [
							"id",
							"campaign_name",
							"job_id",
							"account_id",
							"created_on",
							"created_by",
							"job_name",
							"job_slug",
							"created_by_name"
						]
					}
				},
				"first_page_url": {
					"type": "string",
					"format": "uri"
				},
				"from": {
					"type": "integer"
				},
				"next_page_url": {
					"type": ["string", "null"],
					"format": "uri"
				},
				"path": {
					"type": "string",
					"format": "uri"
				},
				"per_page": {
					"type": "integer"
				},
				"prev_page_url": {
					"type": ["string", "null"],
					"format": "uri"
				},
				"to": {
					"type": "integer"
				}
			},
			"required": [
				"current_page",
				"data",
				"first_page_url",
				"from",
				"next_page_url",
				"path",
				"per_page",
				"prev_page_url",
				"to"
			]
		},
		"filter_count": {
			"type": "integer"
		}
	},
	"required": [
		"records",
		"filter_count"
	]
}

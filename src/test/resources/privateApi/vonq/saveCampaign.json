{
	"$schema": "http://json-schema.org/draft-07/schema#",
	"type": "object",
	"properties": {
		"message": {
			"type": "string"
		},
		"data": {
			"type": "object",
			"properties": {
				"campaign": {
					"type": "object",
					"properties": {
						"campaign_name": {
							"type": "string"
						},
						"job_id": {
							"type": "integer"
						},
						"campaign_id": {
							"type": "string",
							"format": "uuid"
						},
						"status": {
							"type": "string"
						},
						"currency": {
							"type": "string"
						},
						"total_price": {
							"type": "number"
						},
						"account_id": {
							"type": "integer"
						},
						"created_by": {
							"type": "integer"
						},
						"created_on": {
							"type": "string",
							"format": "date-time"
						},
						"id": {
							"type": "integer"
						}
					},
					"required": [
						"campaign_name",
						"job_id",
						"campaign_id",
						"status",
						"currency",
						"total_price",
						"account_id",
						"created_by",
						"created_on",
						"id"
					]
				},
				"campaign_channels": {
					"type": "array",
					"items": {
						"type": "object",
						"properties": {
							"channel_name": {
								"type": "string"
							},
							"channel_id": {
								"type": "string"
							},
							"is_product": {
								"type": "boolean"
							},
							"status": {
								"type": "string"
							},
							"currency": {
								"type": "string"
							},
							"total_price": {
								"type": "number"
							},
							"job_board_link": {
								"type": "string"
							},
							"start_date": {
								"type": "integer"
							},
							"end_date": {
								"type": "integer"
							},
							"campaign_id": {
								"type": "integer"
							},
							"created_by": {
								"type": "integer"
							},
							"created_on": {
								"type": "integer"
							},
							"account_id": {
								"type": "integer"
							}
						},
						"required": [
							"channel_name",
							"channel_id",
							"is_product",
							"status",
							"currency",
							"total_price",
							"job_board_link",
							"start_date",
							"end_date",
							"campaign_id",
							"created_by",
							"created_on",
							"account_id"
						]
					}
				}
			},
			"required": [
				"campaign",
				"campaign_channels"
			]
		},
		"status": {
			"type": "string"
		},
		"message_type": {
			"type": "string"
		}
	},
	"required": [
		"message",
		"data",
		"status",
		"message_type"
	]
}

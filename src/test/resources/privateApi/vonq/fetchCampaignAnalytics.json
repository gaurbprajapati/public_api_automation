					"type": "integer"
				},
				"campaign_name": {
					"type": "string"
				},
				"job_id": {
					"type": "integer"
				},
				"campaign_id": {
					"type": "string",
					"format": "uuid"
				},
				"status": {
					"type": "string"
				},
				"currency": {
					"type": "string"
				},
				"total_price": {
					"type": "integer"

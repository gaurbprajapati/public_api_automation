            </class>
        </classes>
    </test>

    <test name="Timesheet Deal Name Filter Test">
        <classes>
            <class name="io.recruitcrm.contractStaffing.Filters.allTimesheetPage.dealNameFilter.TimesheetDealNameFilterTest">
                <methods>
                    <include name="timesheetDealNameFilterTest" />
                </methods>
            </class>
        </classes>
    </test>

    <test name="Timesheet Deal Search Entity Test">
        <classes>
            <class name="io.recruitcrm.contractStaffing.Filters.allTimesheetPage.searchEntity.TimesheetDealSearchEntityTest">
                <methods>
                    <include name="timesheetDealSearchEntityTest" />
                </methods>
            </class>
        </classes>
    </test>

    <test name="Timesheet Period Filter Test">
        <classes>
            <class name="io.recruitcrm.contractStaffing.Filters.allTimesheetPage.timesheetPeriodFilter.TimesheetPeriodFilterTest">

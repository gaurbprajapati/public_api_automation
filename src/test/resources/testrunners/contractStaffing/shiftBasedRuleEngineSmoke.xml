			<class name="io.recruitcrm.contractStaffing.shiftBasedRuleEngineCalculation.smoke.ShiftBasedRuleEngineSmokeTest">
				<methods>
					<include name="smokeVerifyMonthlyCalculations" />
				</methods>
			</class>
		</classes>
	</test>

	<test name="Shift_Rule_Engine_Smoke_Unallocated_hours">
		<classes>
			<class name="io.recruitcrm.contractStaffing.shiftBasedRuleEngineCalculation.smoke.ShiftBasedRuleEngineSmokeTest">
				<methods>
					<include name="smokeVerifyUnallocatedHoursCalculations" />
				</methods>
			</class>
		</classes>
	</test>

</suite>

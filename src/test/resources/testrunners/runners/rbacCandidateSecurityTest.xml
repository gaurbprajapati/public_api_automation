<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "http://testng.org/testng-1.0.dtd">

<suite name="RBAC Candidate View Security Test Suite" thread-count="8" parallel="tests">
    <listeners>
        <listener class-name="io.rcrm.api.listeners.ExtentReporterNG"/>
    <listener class-name="io.rcrm.api.listeners.TestTrackingListener" />
    </listeners>
    <test name="RBAC Candidate Create Security - all">
        <parameter name="role" value="all"/>
        <classes>
            <class name="io.recruitcrm.albatross.candidate.RBACCandidateCreateSecurityTest">
                <methods>
                    <include name="createCandidateSecurityTest"/>
                </methods>
            </class>
        </classes>
    </test>
    <test name="RBAC Candidate View Security Test">
        <parameter name="role" value="all"/>
        <classes>
            <class name="io.recruitcrm.albatross.candidate.RBACCandidateViewEditDeleteSecurityTest">

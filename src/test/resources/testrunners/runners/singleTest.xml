			<class name="io.recruitcrm.albatross.neptune.GenerateCallLogSummaryTest">
				<methods>
					<include name="generateCallLogSummary_Test" />
					<include name="generateCallLogSummaryWithInvalidKey_Test" />
					<include name="generateCallLogSummaryWithNullValues_Test" />
				</methods>
			</class>
		</classes>
	</test>


<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "http://testng.org/testng-1.0.dtd">
<suite name="Rest API Test Suite" thread-count="40" parallel="tests">
    <listeners>
        <listener class-name="io.rcrm.api.listeners.ExtentReportListener"/>
        <listener class-name="io.rcrm.api.listeners.FilterSearchReporter"/>
    </listeners>
    <test name="Owner Dropdown Contact Filter Search">
        <classes>
            <class name="io.recruitcrm.ContactService.Filters.DropdownFieldsContactFilterSearchTest">
                <methods>
                    <include name="ownerDropdownFieldFilterSearchTest" />
                </methods>
            </class>
        </classes>
    </test>
    <test name="CreatedBy Dropdown Contact Filter Search">
        <classes>
            <class name="io.recruitcrm.ContactService.Filters.DropdownFieldsContactFilterSearchTest">
                <methods>
                    <include name="createdByDropdownFieldFilterSearchTest" />
                </methods>
            </class>
        </classes>
    </test>
    <test name="UpdatedBy Dropdown Contact Filter Search">
        <classes>
            <class name="io.recruitcrm.ContactService.Filters.DropdownFieldsContactFilterSearchTest">
                <methods>
                    <include name="updatedByDropdownFieldFilterSearchTest" />
                </methods>
            </class>
        </classes>
    </test>
    <test name="Stage Dropdown Contact Filter Search">
        <classes>
            <class name="io.recruitcrm.ContactService.Filters.DropdownFieldsContactFilterSearchTest">
                <methods>
                    <include name="stageDropdownFieldFilterSearchTest" />
                </methods>
            </class>
        </classes>
    </test>
    <test name="LastCommsType Dropdown Contact Filter Search">
        <classes>
            <class name="io.recruitcrm.ContactService.Filters.DropdownFieldsContactFilterSearchTest">
                <methods>
                    <include name="lastCommsTypeDropdownFieldFilterSearchTest" />
                </methods>
            </class>
        </classes>
    </test>
    <test name="Hotlist Contact Filter Search">
        <classes>
            <class name="io.recruitcrm.ContactService.Filters.HotlistFieldContactFilterSearchTest">
                <methods>
                    <include name="hotlistFieldFilterSearchTest" />
                </methods>
            </class>
        </classes>
    </test>
</suite>

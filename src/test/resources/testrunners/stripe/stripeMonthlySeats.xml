<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "http://testng.org/testng-1.0.dtd" >

<suite name="Stripe Monthly Seats Renewal Test Suite" parallel="tests" thread-count="20">

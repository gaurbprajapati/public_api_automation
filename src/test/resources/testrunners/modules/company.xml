<?xml version="1.0" encoding="UTF-8"?>

<!DOCTYPE suite SYSTEM "http://testng.org/testng-1.0.dtd" >

<!-- Owner - Titans - Varun Vishwakarma, Shivam Singh -->
<suite name="Rest API Test Suite" verbose="1" parallel="methods"
	thread-count="8">

	<listeners>
		<listener class-name="io.rcrm.api.listeners.ExtentReporterNG" />
	<listener class-name="io.rcrm.api.listeners.TestTrackingListener" />
	</listeners>

	<test name="AllEndpointsOfCompany Company Endpoints">
		<classes>
			<class name="io.rcrm.api.company.AllEndpointsOfCompanyTest">
				<methods>

					<include name="createNewCompany_POST" />
					<include name="editCompanyBySlug_POST" />
					<include name="verifyValidationOfCreateNewCompany" />
					<include name="showAllCompanies_GET" />
					<include name="searchCompanyByName_GET" />
					<include name="searchCompanyBySlug_GET" />
					<include name="deleteCompanyBySlug_GET" />

				</methods>
			</class>
		</classes>
	</test>

	<test name="Create New Endpoints">
		<classes>
			<class name="io.rcrm.api.company.CreateNewCompanyTest">
				<methods>

					<include name="createNewCompanyWithMandatoryFields_POST" />
					<include name="createNewCompanyWithEmptyRequestBody_POST" />
					<include name="createNewCompanyWithAllFields_POST" />
					<include name="verifyInvalidCompanyName" />
					<include name="verifyEmptyCompanyName" />
					<include
						name="verifyCreateNewCompanyWithInvalidFieldsValue_POST" />
					<include name="verifyInvalidCompanyLogo" />

				</methods>
			</class>
		</classes>
	</test>




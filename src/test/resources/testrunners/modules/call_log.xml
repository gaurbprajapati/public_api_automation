					<include name="addCallLog_POST" />
					<include name="editCallLog_POST" />
 					<include name="getCallLogActivityData_GET" />
					<include name="getCallLogList_GET" />
					<include name="deleteCallLog_DELETE" />
				</methods>
			</class>
		</classes>
	</test>

	<test name="Call Log Albatross - Automated Call Log Restriction">

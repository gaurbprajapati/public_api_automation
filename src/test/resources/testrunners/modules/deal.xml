<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "http://testng.org/testng-1.0.dtd" >

<!-- Owner - Titans - Varun Vishwakarma, Shivam Singh -->
<suite name="Rest API Test Suite" verbose="1" parallel="methods"
	thread-count="7">

	<listeners>
		<listener class-name="io.rcrm.api.listeners.ExtentReporterNG" />
	<listener class-name="io.rcrm.api.listeners.TestTrackingListener" />
	</listeners>

	<test name="All Deal Endpoints">
		<classes>
			<class name="io.rcrm.api.deals.AllEndPointsOfDealsTests">
				<methods>
                    <include name="createNewDealWithAllFields" />
					<include name="showAllDealsGET" />
					<include name="searchDealByFields" />
					<include name="editDealBySlug" />
					<include name="searchDealBySlug" />
					<include name="deleteDealBySlug" />
					<include name="getDealStageHistory"/>
				</methods>
			</class>
		</classes>
	</test>
	
	<test name="Create Deal Endpoints">
		<classes>
			<class name="io.rcrm.api.deals.CreateNewDealTest">
				<methods>
					<include name="createNewDealWithMandatoryFields" />
					<include name="createNewDealWithAllFields" />
					<include name="userShouldNotAbleToCreateDealWithEmptyData" />
					<include
						name="userShouldNotAbleToCreateDealWithMoreThanLimit" />
					<include name="unauthorizedUserCreateNewDeal" />
					<include name="createDealWithInvalidDealSplitData" />
				</methods>
			</class>
		</classes>
	</test>
	<test name="Edit Deal Endpoints">
		<classes>
			<class name="io.rcrm.api.deals.EditDealTest">
				<methods>
					<include name="createNewDeal_POST" />
					<!-- <include name="editDealBySlug422_POST" /> -->
					<include name="editDealBySlug_POST" />
					<include name="editDealByInvalidSlug404_POST" />
					<include name="editDealByInvalidFieldsValues422_POST" />
					<include name="unauthorizedUserCannotEditDeal" />
					<include name="editDealWithInvalidDealSplitData" />
				</methods>
			</class>
		</classes>
	</test>
	<test name="Search Deal by Slug">
		<classes>

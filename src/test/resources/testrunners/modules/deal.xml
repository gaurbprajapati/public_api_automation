				<methods>
					<include name="createNewDealWithMandatoryFieldsForSearch" />
					<include name="searchDealByAllFields_GET" />
					<include name="searchDealByName_GET" />
					<include name="searchDealByAllFields_GET" />
					<include name="searchDealBySlug_GET" />
					<include name="searchDealByInvalidName_GET" />
					<include name="unauthorizedUserCannotSearchDealByFields" />
					<include name="searchDealByAddedFrom" />
					<include name="searchDealByAddedTo" />
					<include name="searchDealByClosingFrom" />
					<include name="searchDealByClosingTo" />
					<include name="searchDealByUpdatedFrom" />
					<include name="searchDealByUpdatedTo" />
				</methods>
			</class>
		</classes>
	</test>

<?xml version="1.0" encoding="UTF-8"?>

<!DOCTYPE suite SYSTEM "http://testng.org/testng-1.0.dtd">


<!-- Owner - Technostars - Harika Kurella, Priyanka Shinde -->

<suite name="Rest API Test Suite" verbose="1" parallel="methods" thread-count="5">

	<listeners>

		<listener class-name="io.rcrm.api.listeners.ExtentReporterNG" />

	<listener class-name="io.rcrm.api.listeners.TestTrackingListener" />
	</listeners>
	
		
 	<test name="Create New Meeting Endpoint">

		<classes>

			<class name="io.rcrm.api.meeting.CreateNewMeetingTest">

				<methods>

					<include name="createNewMeetings" />
					<include name="createMeetingsWithDisableAutoTeamsPopulation" />
					<include name="createMeetingsWithEnableAutoTeamsPopulation" />
					<include name="createMeetingsWithCollaborators" />
					<include name="createMeetingsWithInvalidCollaborators" />
					<include name="createMeetingsWithInvalidCollaboratorsTeams" />
					<include name="createMeetingsWithInvalidCalendarInviteValue" />
					<include name="createNewMeetingsWithAssociates" />
					<include name="userShouldNotBeAbleToCreateNewMeetingWithEmptyFieldsData" />
					<include name="verifyMeetingDescriptionWithMaxChars" />

				</methods>

			</class>

		</classes>

	</test>


	<test name="All Endpoints of Meeting Endpoint">

		<classes>

			<class name="io.rcrm.api.meeting.AllEndPointsOfMeetingTest">

				<methods>

					<include name="createNewMeeting" />

					<include name="showAllMeeting" />

					<include name="editMeetingByID" />

					<include name="searchMeetingByFields" />

					<include name="searchMeetingByID" />

					<include name="deleteMeetingByID" />


				</methods>

			</class>

		</classes>

	</test>

	<test name="Meeting type Test-cases -6-Done">
		<classes>
			<class name="io.rcrm.api.meeting.MeetingTypeTest">
				<methods>
					<include name="getMeetingTypes" />
					<include name="createMeetingWithMeetingType" />
					<include name="verifyMeetingTypeInShowAllMeeting" />
					<include name="verifyMeetingTypeInSearchMeetingByID" />
					<include name="editMeetingType" />
					<include name="createMeetingWithInvalidMeetingType" />
				</methods>
			</class>
		</classes>
	</test>


	<test name="delete Meeting Endpoint"
		<classes>
			<class name="io.rcrm.api.meeting.DeleteMeetingTest">
				<methods>
					<include name="deleteMeetingByID" />
					<include name="deleteMeetingByInvalidID" />
					<include name="unauthorizedUserShouldNotAbleToDeleteMeetingByID" />
					<include name="deleteMeetingCreatedByUsers" />
				</methods>
			</class>
		</classes>
	</test>


	<test name="Search Meeting by ID Endpoint">

		<classes>

			<class name="io.rcrm.api.meeting.SearchMeetingByIdTest">

				<methods>

					<include name="searchMeetingByID" />

					<include name="unauthorizedUserShouldNotBeAbleToSearchMeetingByID_MeetingTest" />


				</methods>

			</class>

		</classes>

	</test>


	<test name="Get All Meeting ">

		<classes>

			<class name="io.rcrm.api.meeting.GetAllMeetingTest">

				<methods>

					<include name="getAllMeeting_Test" />

					<include name="unauthorizedUserCannotGetAllMeeting_Test" />


				</methods>

			</class>

		</classes>

	</test>


	<test name="Search Meeting by fields">

		<classes>

			<class name="io.rcrm.api.meeting.SearchMeetingByFieldsTest">

				<methods>

					<include name="searchMeetingByFields_Test" />

					<include name="unauthorizedUserCannotSearchMeetingByFields_Test" />

					<include name="searchMeetingByInvalidFields_Test" />
					<include name="searchMeetingByAddedFrom" />
					<include name="searchMeetingByAddedTo" />
					<include name="searchMeetingByClosingFrom" />
					<include name="searchMeetingByClosingTo" />
					<include name="searchMeetingByStartingFrom" />
					<include name="searchMeetingByStartingTo" />

				</methods>

			</class>

		</classes>

	</test>


	<test name="edit Meeting by fields">

		<classes>

			<class name="io.rcrm.api.meeting.EditMeetingTest">

				<methods>

					<include name="editMeetingByID" />
     				<include name="editMeetingCalendarInviteOption" />
					<include name="unauthorizedUserCannotEditMeetingByID" />

				</methods>

			</class>

		</classes>

	</test>


</suite>
        <classes>
            <class name="io.recruitcrm.ContactService.Filters.DropdownFieldsContactFilterSearchTest">
                <methods>
                    <include name="lastCommsTypeDropdownFieldFilterSearchTest" />
                </methods>
            </class>
        </classes>
    </test>
</suite>

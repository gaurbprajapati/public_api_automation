<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "http://testng.org/testng-1.0.dtd">
<suite name="Contact Field Filter Search" thread-count="40" parallel="tests">
    <listeners>
        <listener class-name="io.rcrm.api.listeners.ExtentReportListener"/>
        <listener class-name="io.rcrm.api.listeners.FilterSearchReporter"/>
    </listeners>
    
    <test name="Text Type Contact Filter Search">
        <classes>
            <class name="io.recruitcrm.ContactService.Filters.TextFieldContactFilterSearchTest">
                <methods>
                    <include name="textFieldFilterSearchTest" />
                </methods>
            </class>
        </classes>
    </test>
    
    <test name="Number Type Contact Filter Search">
        <classes>
            <class name="io.recruitcrm.ContactService.Filters.NumberFieldContactFilterSearchTest">
                <methods>
                    <include name="numberFieldFilterSearchTest" />
                </methods>
            </class>
        </classes>
    </test>
    
    <test name="Date Type Contact Filter Search">
        <classes>
            <class name="io.recruitcrm.ContactService.Filters.DateFieldContactFilterSearchTest">
                <methods>
                    <include name="dateFieldFilterSearchTest" />
                </methods>
            </class>
        </classes>
    </test>
    
    <test name="Hotlist Contact Filter Search">

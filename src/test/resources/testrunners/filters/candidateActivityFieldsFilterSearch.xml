<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "http://testng.org/testng-1.0.dtd">
<suite name="Candidate Filters - Activity Fields Only" thread-count="40" parallel="tests">
    <listeners>
        <listener class-name="io.rcrm.api.listeners.ExtentReportListener"/>
        <listener class-name="io.rcrm.api.listeners.FilterSearchReporter"/>
    </listeners>

    <!-- Notes Activity Filters -->
    <test name="Notes Date Field Candidate Filter Search">
        <classes>
            <class name="io.recruitcrm.CandidateService.Filters.NotesActivityFieldsCandidateFilterSearchTest">
                <methods>
                    <include name="notesDateFieldFilterSearchTest"/>
                </methods>
            </class>
        </classes>
    </test>

    <test name="Notes Multiselect/Dropdown Candidate Filter Search">
        <classes>
            <class name="io.recruitcrm.CandidateService.Filters.NotesActivityFieldsCandidateFilterSearchTest">
                <methods>
                    <include name="notesMultiselectFilterSearchTest"/>
                </methods>
            </class>
        </classes>
    </test>

    <test name="Notes Note Exists (checkbox) Candidate Filter Search">
        <classes>
            <class name="io.recruitcrm.CandidateService.Filters.NotesActivityFieldsCandidateFilterSearchTest">
                <methods>
                    <include name="notesNoteExistsFilterSearchTest"/>
                </methods>
            </class>
        </classes>
    </test>

    <!-- Call Log Activity Filters -->
    <test name="Call Log Date Field Candidate Filter Search">
        <classes>
            <class name="io.recruitcrm.CandidateService.Filters.CallLogActivityFieldsCandidateFilterSearchTest">

            <class name="io.recruitcrm.CandidateService.Filters.CallLogActivityFieldsCandidateFilterSearchTest">
                <methods>
                    <include name="callLogMultiselectFilterSearchTest"/>
                </methods>
            </class>
        </classes>
    </test>

    <test name="Call Log Exists (checkbox) Candidate Filter Search">
        <classes>
            <class name="io.recruitcrm.CandidateService.Filters.CallLogActivityFieldsCandidateFilterSearchTest">
                <methods>
                    <include name="callLogCallExistsFilterSearchTest"/>
                </methods>
            </class>
        </classes>
    </test>

    <!-- Task Activity Filters -->
    <test name="Task Text Field Candidate Filter Search">
        <classes>
            <class name="io.recruitcrm.CandidateService.Filters.TaskActivityFieldsCandidateFilterSearchTest">
                <methods>
                    <include name="tasksTextFieldFilterSearchTest"/>
                </methods>
            </class>
        </classes>
    </test>

    <test name="Task Date Field Candidate Filter Search">
        <classes>
            <class name="io.recruitcrm.CandidateService.Filters.TaskActivityFieldsCandidateFilterSearchTest">
                <methods>
                    <include name="tasksDateFieldFilterSearchTest"/>
                </methods>
            </class>
        </classes>
    </test>

    <test name="Task Multiselect/Dropdown Candidate Filter Search">
        <classes>
            <class name="io.recruitcrm.CandidateService.Filters.TaskActivityFieldsCandidateFilterSearchTest">
                <methods>
                    <include name="tasksMultiselectFilterSearchTest"/>
                </methods>
            </class>
        </classes>
    </test>

    <test name="Task Exists (checkbox) Candidate Filter Search">
        <classes>
            <class name="io.recruitcrm.CandidateService.Filters.TaskActivityFieldsCandidateFilterSearchTest">
                <methods>
                    <include name="tasksTaskExistsFilterSearchTest"/>
                </methods>
            </class>
        </classes>
    </test>

    <!-- Meeting Activity Filters -->
    <test name="Meeting Text Field Candidate Filter Search">
        <classes>
            <class name="io.recruitcrm.CandidateService.Filters.MeetingActivityFieldsCandidateFilterSearchTest">
                <methods>
                    <include name="meetingsTextFieldFilterSearchTest"/>
                </methods>
            </class>
        </classes>
    </test>

    <test name="Meeting Date Field Candidate Filter Search">
        <classes>

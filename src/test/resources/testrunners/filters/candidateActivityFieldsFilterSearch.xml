                </methods>
            </class>
        </classes>
    </test>

    <test name="Meeting Exists (checkbox) Candidate Filter Search">
        <classes>
            <class name="io.recruitcrm.CandidateService.Filters.MeetingActivityFieldsCandidateFilterSearchTest">
                <methods>
                    <include name="meetingsMeetingExistsFilterSearchTest"/>
                </methods>
            </class>
        </classes>
    </test>

</suite>
                <methods>
                    <include name="tasksTextFieldFilterSearchTest" />
                </methods>
            </class>
        </classes>
    </test>

    <test name="Task Exists (checkbox) Contact Filter Search">
        <classes>
            <class name="io.recruitcrm.ContactService.Filters.TaskActivityFieldsContactFilterSearchTest">
                <methods>
                    <include name="tasksTaskExistsFilterSearchTest"/>
                </methods>
            </class>
        </classes>
    </test>

</suite>